[Unit]
Description=Muse Realtime Bridge
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/muse-realtime-bridge
ExecStart=%h/muse-realtime-bridge/.venv/bin/muse-realtime-bridge --env-file %h/muse-realtime-bridge/.env
Restart=on-failure
RestartSec=5
TimeoutStopSec=10
NoNewPrivileges=true
UMask=0077

[Install]
WantedBy=default.target
