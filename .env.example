# Muse VM: read docs/muse-setup.md first; register the real key in the credential store.
# Surrogate-token use with the SDK WebSocket is NOT yet verified.
# Never put the real key here on Muse or copy it to the StopWatch.
OPENAI_API_KEY=replace-after-credential-setup
# Generate with: python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
# This is a NEW bridge credential, NOT vm_auth_token or a Muse SDK token.
BRIDGE_TOKEN=replace-with-a-random-bridge-token
BRIDGE_HOST=127.0.0.1
BRIDGE_PORT=8787
OPENAI_REALTIME_MODEL=gpt-realtime
OPENAI_REALTIME_VOICE=marin
OPENAI_REALTIME_INSTRUCTIONS="日本語で、短く自然に話してください。"
BRIDGE_MAX_CONNECTIONS=1
BRIDGE_SESSION_SECONDS=600
BRIDGE_IDLE_SECONDS=60
