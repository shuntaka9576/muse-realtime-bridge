# Muse VM: read docs/muse-setup.md first; register the real key in the credential store.
# Surrogate-token use with the SDK WebSocket is NOT yet verified.
# Never put the real key here on Muse or copy it to the StopWatch.
# Empty: echo works; /realtime returns 503 until a credential is configured.
OPENAI_API_KEY=
# Leave empty for loopback behind Muse's authenticated ingress.
BRIDGE_TOKEN=
BRIDGE_HOST=127.0.0.1
BRIDGE_PORT=8787
OPENAI_REALTIME_MODEL=gpt-realtime
OPENAI_REALTIME_VOICE=marin
OPENAI_REALTIME_INSTRUCTIONS="日本語で、短く自然に話してください。"
BRIDGE_MAX_CONNECTIONS=1
BRIDGE_SESSION_SECONDS=600
BRIDGE_IDLE_SECONDS=60
