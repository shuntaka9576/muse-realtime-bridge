# VM only. Never copy the OpenAI key to the StopWatch.
OPENAI_API_KEY=replace-with-your-openai-api-key
# Generate with: python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
# This is a NEW bridge credential, NOT vm_auth_token or a Muse SDK token.
BRIDGE_TOKEN=replace-with-a-random-bridge-token
BRIDGE_HOST=127.0.0.1
BRIDGE_PORT=8787
OPENAI_REALTIME_MODEL=gpt-realtime
OPENAI_REALTIME_VOICE=marin
OPENAI_REALTIME_INSTRUCTIONS="日本語で、短く自然に話してください。"
BRIDGE_MAX_CONNECTIONS=1
BRIDGE_SESSION_SECONDS=600
BRIDGE_IDLE_SECONDS=60
